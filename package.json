    "ignore": "^7.0.14",
    "image-size": "2.1.0",
    "lucide-react": "^1.69.0",
    "material-icon-theme": "5.40.0",
    "patch-package": "8.0.1",
    "pdfjs-dist": "5.4.296",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "10.4.1",
    "react-resizable-panels": "^4.18.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
