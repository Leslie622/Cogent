{
  "name": "cogent",
  "version": "0.1.0",
  "description": "Cogent — an agent application built on Electron + pi",
  "main": "out/main/index.js",
  "type": "module",
  "author": "Cogent",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "node scripts/check-typography.mjs && eslint .",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "node tests/run-tests.mjs run",
    "test:watch": "node tests/run-tests.mjs --project node --project web --watch",
    "coverage": "node tests/run-tests.mjs run --coverage",
    "theme:check": "node scripts/themd-theme.mjs --check",
    "test:theme-browser": "node scripts/check-theme-browser.mjs",
    "test:notify-sounds-browser": "node scripts/check-notify-sounds-browser.mjs",
    "test:chat-layout-browser": "node scripts/check-chat-layout-browser.mjs",
    "test:file-links-electron": "node scripts/check-file-links-electron.mjs",
    "test:outputs-electron": "node scripts/check-outputs-electron.mjs",
    "test:workspace-electron": "node scripts/check-workspace-memory-electron.mjs",
    "test:workspace-performance": "node scripts/check-workspace-performance-electron.mjs",
    "fetch:runtime": "node scripts/fetch-runtime.mjs",
    "postinstall": "patch-package --error-on-fail"
  },
