    "@streamdown/mermaid": "1.0.2",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-virtual": "3.14.26",
    "@uiw/color-convert": "2.10.3",
    "@uiw/react-color-alpha": "2.10.3",
    "@uiw/react-color-hue": "2.10.3",
