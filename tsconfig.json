{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }],
  // 路径别名同时声明在根 tsconfig，供编辑器与 shadcn CLI 解析。
  //（baseUrl 已弃用：TS 4.1 起 paths 缺省相对 tsconfig 所在目录解析，无需 baseUrl）
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
