  view flowAuth {
    title '身份验证与权限'
    include flow.auth.*, flow.auth.entries.*
  }

  view flowAuthCode {
    title '身份验证与权限（源码调用图）'
    include flow.authCode.*
  }

  view flowApproval {
    title '消息与审批闭环'
    include flow.approval.*, flow.approval.submit.*
  }

  view flowApprovalCode {
    title '消息与审批闭环（源码调用图）'
    include flow.approvalCode.*
  }

  view flowMcp {
    title 'MCP 双轨机制'
    include flow.mcpFlow.*, flow.mcpFlow.client.*, flow.mcpFlow.server.*
  }

  view flowMcpCode {
    title 'MCP 双轨机制（源码调用图）'
    include flow.mcpCode.*
  }

  view flowSkills {
    title '技能加载机制'
    include flow.skills.*, flow.skills.writePath.*, flow.skills.consume.*
  }

  view flowSkillsCode {
    title '技能加载机制（源码调用图）'
    include flow.skillsCode.*
  }

  view flowHooks {
    title '钩子与扩展机制'
    include flow.hooks.*, flow.hooks.extHooks.*, flow.hooks.wrappers.*, flow.hooks.extensions.*
  }

  view flowHooksCode {
    title '钩子与扩展机制（源码调用图）'
    include flow.hooksCode.*
  }

  view flowCompaction {
    title '上下文工程与压缩转录'
    include flow.compaction.*, flow.compaction.entering.*, flow.compaction.compacting.*, flow.compaction.outputs.*
  }

  view flowCompactionCode {
    title '上下文工程（源码调用图）'
    include flow.compactionCode.*
  }

  view flowOutputs {
    title '文件边界与产物交付'
    include flow.outputs.*, flow.outputs.intake.*, flow.outputs.deliver.*, flow.outputs.viewer.*
  }

  view flowOutputsCode {
    title '文件边界与产物交付（源码调用图）'
    include flow.outputsCode.*
  }

  view flowModels {
    title '凭据与模型出站'
    include flow.models.*, flow.models.creds.*, flow.models.outbound.*
  }

  view flowModelsCode {
    title '凭据与模型出站（源码调用图）'
    include flow.modelsCode.*
  }

  view flowPrompts {
    title '提示词工程与装配'
    include flow.prompts.*, flow.prompts.systemLayer.*, flow.prompts.toolLayer.*, flow.prompts.msgLayer.*
  }

  view flowPromptsCode {
    title '提示词工程（源码调用图）'
    include flow.promptsCode.*
  }
}
