// 目标架构：结构、接线与视图在此维护；能力完成度、契约与源码依据由模块说明统一维护。
specification {
  tag planned
  element system {
    style { color muted; size xs }
  }
  element component {
    style {
      color muted
      size xs
    }
  }
  relationship call {
    line solid
    head normal
  }
  relationship configuration {
    line dashed
    head open
  }
  relationship assembly {
    line dashed
    head open
  }
  relationship dependency {
    line dotted
    head open
  }
}

model {
  desktop = system '主 UI 桌面壳' {
    technology 'Electron · IPC'
    description '桌面前端、Preload 白名单桥与 Electron 主进程，通过 stdio 驱动 Host。'

    renderer = system 'Renderer 界面层' {
      technology 'React · Zustand'
      description '无 Node 权限；仅通过 window.cogent 白名单桥调用主进程。'

      ui = component '主界面与设置' {
        technology 'AppShell · HomeChat'
        description '负责会话对话、设置页、审批面板与控制台呈现。'
      }
      workspace = component '多标签工作区' {
        technology 'WorkspaceFrame'
        description '常驻承载文件导航、代码/文档预览与内嵌浏览器面板。'
      }
    }

    preload = system 'Preload 隔离桥' {
      technology 'contextBridge'
      description '显式暴露受限 API，隔离 renderer 与 Electron/Node。'

      main = component '主窗口桥' {
        technology 'preload/index.ts'
        description '暴露 engineRequest、专属审批与凭据白名单接口。'
      }
      guest = component 'Guest 沙箱桥' {
        technology 'preload/guest.ts'
        description '仅注入可信 demo webview 的最小 SDK 能力。'
      }
    }

    main = system 'Electron 主进程' {
      technology 'Electron 40 · Node 24'
      description '窗口生命周期、分域 IPC 校验、凭据加密与 Host 子进程托管。'

      ipc = component '分域 IPC 路由' {
        technology 'handleTrusted · engineRequest'
        description '按域收窄调用来源与参数；审批与凭据写走专属通道。'
      }
      browser = component '浏览器与 Webview 硬化' {
        technology 'BrowserTabRuntime'
        description '强制沙箱、隔离 Partition 与来源策略。'
      }
      credentials = component '凭据加密存取' {
        technology 'safeStorage'
        description '负责宿主密钥的加密落盘与开机交接，明文不进 Host 磁盘。'
      }
      hostManager = component 'Host 进程管理' {
        technology 'HostManager · Node 22'
        description '定位自带 Node 22 并拉起 Host，维护 stdio 管道与重启恢复。'
      }
    }
  }

  nativeClients = component 'Cogent 原生调用' {
    technology 'UI · 远程服务'
    description '使用 Cogent 原生协议的 UI 或远程服务；按调用所用协议分类，不把远程等同于 UI。'
  }
  customClients = component '自有协议调用方' {
    technology 'UI · 远程服务'
    description '已有自己协议的 UI（远程、内嵌、自定义）或远程服务，需要 Cogent 适配其协议。'
  }
  externalAgent = component '外部 Agent' {
    technology 'MCP 客户端'
  }
  mcp = component 'MCP 协议适配' {
    technology 'MCP Server'
    description '独立 MCP Server 将标准 MCP 工具调用转换成 Cogent 原生方法，并将结果与错误包装回 MCP 响应。'
  }

  access = system '传输入口' {
    technology 'stdio · HTTP · WS'

    stdio = component 'stdio JSON-RPC' {
      technology '进程管道'
      description 'Electron 主进程通过子进程管道调用 Host；UI 通过 preload 与 IPC 交给主进程。'
    }

    network = system '网络入口' {
      technology 'HTTP · WebSocket 传输'
      http = component 'HTTP' {
        technology '请求与响应'
        description '通过 HTTP 发起调用，Cogent 原生入口为 /rpc；自定义旧路由由目标协议适配层处理。'
      }
      ws = component 'WebSocket' {
        technology '双向调用与事件'
        description '通过 /ws 持续连接，支持方法调用与事件推送。'
      }
    }
  }

  host = system '引擎服务（Host）' {
    technology '独立 Node 进程'

    authentication = component '身份认证' {
      technology 'Host token · 用户 token'
      description '验证凭据，建立调用身份；现有 Host token 与未来用户系统采用可替换的认证实现。'
    }

    native = component 'Cogent 原生协议' {
      technology 'JSON-RPC 2.0 子集'
      description 'Cogent 原生方法、参数、响应与通知；外部客户端可直接使用。'
    }

    adapter = component '自定义协议适配' {
      technology '兼容 /xxx/chat 等接口'
      description '供沿用自定义接口格式的 UI 等客户端调用，双向转换请求、响应、错误与流式事件。'
    }

    policy = component '权限检查' {
      technology '方法 · 项目 · 会话'
      description '在统一调用上检查方法权限和资源归属，Cogent 原生协议与适配协议遵循同一策略。'
    }

    api = component 'HostApi 分发' {
      technology '方法注册表'
      description '将获得授权的统一调用分发到会话、任务及能力服务。'
    }

    services = system 'Host 服务层' {
      technology '配置真源 · 会话 · 项目 · 凭据'
      description '业务服务负责会话与任务生命周期、项目、凭据桥、观测和能力配置真源。'
      sessions = component '会话与任务' { technology '受理 · 取消 · 恢复' }
      projects = component '项目管理' { technology '工作区 · 会话归属' }
      credentials = component '凭据桥' { technology '宿主密钥注入' }
      observability = component '执行观测' { technology '事件 · 运行记录' }
      configuration = component '能力配置' { technology '管配置真源与快照（不跑模型）' }
    }

    runtime = system 'KernelRunner' {
      technology '自带 Node 22 · SHA256'
      description 'CogentKernel 内核合同；运行基础与安全策略随执行容器展示，当前由 SessionManager 实现。'

      kernel = component 'PiSdkKernel' {
        technology 'pi AgentSession · SDK'
        description '当前唯一内核实现，托管 Agent 循环、工具、上下文压缩和 JSONL 转录。'
      }

      alternative = component '其他内核' {
        technology 'PiRpcKernel · 其他实现'
        description '内核合同的替换扩展位；当前没有第二个内核实现。'
      }

      capabilities = system '执行能力' {
        technology '运行时装配（消费能力配置）'
        description '消费 Host 服务层能力配置快照，按 pi 官方工具和扩展形状装配进内核会话；含交互工具，子会话为预留。'
        tools = component '内置工具' { technology '文件 · 搜索 · 执行' }
        mcp = component 'MCP 工具' { technology '外部工具连接与装配' }
        skills = component '技能' { technology '知识与提示段加载' }
        hooks = component '钩子' { technology '生命周期干预' }
        interaction = component '交互工具' { technology '提问 · 方案 · 任务清单' }
        subagents = component '子会话' { technology '多 Agent 调度预留' }
      }
    }

    provider = component '模型协议适配' {
      technology 'Provider · 远端契约'
      description '将 pi 的模型调用转换成远端 API，并还原响应与流；保留自定义旧契约扩展位。'
    }

    authentication -[call]<-> native 'Cogent 原生协议'
    authentication -[call]<-> adapter '适配调用方协议' { #planned }
    native -[call]<-> policy '统一入站策略'
    adapter -[call]<-> policy '统一调用' { #planned }
    policy -[call]<-> api '方法入站分发'
    api -[call]<-> services '业务 RPC ⇄ 事件'
    services.configuration -[configuration]-> runtime.capabilities '配置快照供给'
    services.sessions -[call]<-> runtime 'submit ⇄ delta/tool'
    runtime.capabilities -[assembly]-> runtime.kernel '装配工具 · 段 · 钩子'
    runtime -[call]<-> provider '方言适配 ⇄ SSE 流'
  }

  storageRoot = system 'COGENT_HOME（~/.cogent）' {
    technology '单写者 · 原子写'
    description '所有持久化文件集中在同一存储根下，按模块划分唯一写者，禁止跨进程双写。'

    shellPrefs = component '壳偏好与授权' {
      technology 'settings · grants · browser'
      description 'Main 原子写入设置、文件目录授权与浏览器站点策略。'
    }
    credentials = component '加密凭据' {
      technology 'credentials.json'
      description 'safeStorage 密文存储；损坏或跨机恢复时显式提示，不静默清空。'
    }
    business = component '业务配置与规则' {
      technology 'defaults · providers · mcp · skills'
      description 'Host 独占管理的默认权限、自定义模型方言、审批规则与能力配置。'
    }
    sessions = component '会话摘要与项目' {
      technology 'sessions/ · projects/'
      description 'JsonStorageDriver 按单文档 JSON + .tmp 原子落盘，损坏文件旁置 .corrupt。'
    }
    outputs = component '交付产物库' {
      technology 'outputs/v1/'
      description '先保存字节副本与 sha256，再原子替换 manifest，与转录和附件分域。'
    }
    inspect = component '执行观测日志' {
      technology 'inspect/*.jsonl'
      description '追加式 JSONL，超限裁剪尾部；尽力落盘，绝不阻断对话。'
    }
    attachments = component '附件内容库' {
      technology 'attachments/v1/'
      description '按内容 SHA256 去重与记录元数据关联会话，草稿/会话释放后才回收对象。'
    }
    searchIndex = component '派生搜索索引' {
      technology 'search/sessions-v1.sqlite'
      description '单 worker 独占维护的 SQLite FTS5 + 短词派生库，损坏可直接重建。'
    }
    transcript = component 'pi 会话转录' {
      technology 'pi/ JSONL 真源'
      description '由 pi 内核在 message_end 追加；搜索与历史回查仅做只读解析。'
    }
  }

  users = component '用户系统' {
    technology '用户身份与凭据'
    description '未来提供用户 token 验证与身份信息，不绑定具体登录平台。'
  }

  models = component '远端模型 API' {
    technology 'HTTP 流式响应'
    description '既有模型 API 或需要保留契约的远端 /xxx/chat 服务。'
  }

  // 桌面壳内部与接入链路
  desktop.renderer.ui -[call]<-> desktop.preload.main 'window.cogent'
  desktop.renderer.workspace -[call]<-> desktop.preload.guest 'guest SDK'
  desktop.preload.main -[call]<-> desktop.main.ipc 'Electron IPC'
  desktop.preload.guest -[call]<-> desktop.main.browser 'webview 策略'
  desktop.main.ipc -[call]<-> desktop.main.credentials '凭据读写'
  desktop.main.ipc -[call]<-> desktop.main.hostManager '引擎代理与审批'
  desktop.main.hostManager -[call]<-> access.stdio 'IPC 转管道'
  desktop.preload.guest -[call]<-> access.network 'HTTP/WS + token'

  // 存储归属（单写者）
  desktop.main -[call]-> storageRoot.shellPrefs '原子写'
  desktop.main -[call]-> storageRoot.credentials 'safeStorage 写'
  host.services -[call]-> storageRoot.business '业务配置写'
  host.services -[call]-> storageRoot.sessions '单文档写'
  host.services -[call]-> storageRoot.outputs '字节与清单写'
  host.services -[call]-> storageRoot.inspect '追加落盘'
  host.services -[call]-> storageRoot.attachments '对象与引用写'
  host.services -[call]-> storageRoot.searchIndex 'worker 派生写'
  host.runtime.kernel -[call]-> storageRoot.transcript 'append-only'

  // 引擎总览主链与外围关系
  access.stdio -[call]<-> host.native '本机调用身份'
  nativeClients -[call]<-> access.network.http 'Cogent 原生协议'
  nativeClients -[call]<-> access.network.ws 'Cogent 原生协议'
  customClients -[call]<-> access.network.http '自定义协议' { #planned }
  customClients -[call]<-> access.network.ws '自定义协议' { #planned }
  customClients -[dependency]-> host.adapter '协议适配关系' {
    #planned
    description '表示此调用方消费该适配能力；实际请求仍经网络入口与身份认证。'
  }
  externalAgent -[call]<-> mcp 'MCP · stdio' {
    description '标准 MCP 的 stdio 连接，由独立 MCP Server 适配为 Cogent 原生调用。'
  }
  mcp -[call]<-> access.network.http '方法调用'
  mcp -[call]<-> access.network.ws '事件订阅'
  access.network.http -[call]<-> host.authentication '携带 token'
  access.network.ws -[call]<-> host.authentication '握手认证'
  users -[call]-> host.authentication '用户身份验证' { #planned }
  host.provider -[call]<-> models '远端协议'
}

views {
  view overview {
    title '架构总览'
    include desktop, nativeClients, customClients, externalAgent, mcp, access.*, host.*, host.runtime.*, models
    include desktop -> access.stdio with { title 'IPC 转管道' }
    include mcp -> access.network with { title 'Cogent 原生协议' }
    include access.network -> host.authentication with { title '验证凭据' }
    include host.authentication -> host.native with { title '原生处理' }
    include host.authentication -> host.adapter with { title '协议转换' }
    exclude desktop -> access.network
    exclude host.services -> host.runtime.capabilities
    exclude host.services.configuration -> host.runtime.capabilities
    exclude host.runtime.capabilities -> host.runtime.kernel
  }

  view desktopShell {
    title '桌面壳内部'
    include desktop.renderer, desktop.renderer.*, desktop.preload, desktop.preload.*, desktop.main, desktop.main.*, access.stdio, access.network
    exclude desktop.main -> storageRoot.shellPrefs
    exclude desktop.main -> storageRoot.credentials
  }

  view services {
    title 'Host 服务层'
    include host.api, host.services, host.services.*, host.runtime, host.runtime.capabilities
    exclude host.services -> storageRoot.*
  }

  view capabilities {
    title '执行能力'
    include host.services.configuration, host.runtime, host.runtime.capabilities, host.runtime.capabilities.*, host.runtime.kernel
    exclude host.services.configuration -> storageRoot.*
  }

  view storage {
    title '数据与存储'
    include desktop.main, host.services, host.runtime.kernel, storageRoot, storageRoot.*
    exclude desktop.main -> access.stdio
    exclude host.services -> host.runtime
  }
}
