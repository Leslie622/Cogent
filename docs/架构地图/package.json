{
  "name": "cogent-architecture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "layout": "node ../../scripts/layout-architecture.mjs",
    "predev": "npm run layout",
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run layout",
    "test": "vitest run",
    "pretest:browser": "npm run build",
    "test:browser": "node ../../scripts/check-architecture-browser.mjs",
    "prebuild": "npm run layout",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@likec4/core": "1.61.0",
    "@xyflow/react": "13.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "likec4": "1.61.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
